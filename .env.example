# Copy to .env. Every value is optional: with none set the app runs in demo mode.

# MongoDB connection string (e.g. a free MongoDB Atlas cluster).
# Unset -> data is kept in memory and resets when the server restarts.
MONGODB_URI=

# AI engine. Set one key; with neither, the built-in rule-based engine classifies, summarises and drafts.
# Gemini has a free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Fast and reliable on the free tier. gemini-3.8-flash is stronger but often busy; other models are tried automatically when one fails.
GEMINI_MODEL=gemini-3.5-flash-lite
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Secret used to sign login tokens. Set a long random value in production.
JWT_SECRET=

PORT=4000
